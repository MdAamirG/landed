# Names only. Copy to .env and fill in locally.

# Set on Render. render.yaml lists them. SESSION_SECRET and DRIVER_LINK_SECRET must match .env.
DATABASE_URL=
DATABASE_URL_POOLED=
GEMINI_API_KEY=
GEMINI_MODEL=
SESSION_SECRET=
DRIVER_LINK_SECRET=
WEB_ORIGIN=
DEMO_MODE=

# Local only, for the Vite dev proxy. Vercel needs no variables: vercel.json holds the rewrite.
VITE_API_URL=

# Tests only, so leave it off Render and Vercel. The test branch's direct URL; its host must differ from DATABASE_URL and DATABASE_URL_POOLED.
DATABASE_URL_TEST=
